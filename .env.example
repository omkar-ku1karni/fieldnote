# Copy to .env and fill in. .env is git-ignored.
# No keys at all is fine too: answers then come from a local Ollama model.

# --- LLM providers ---
GEMINI_API_KEY=
# Optional. Blank means try the models listed in src/fieldnote/llm.py, in order.
GEMINI_MODEL=
GROQ_API_KEY=
# Optional. Blank means use the first vision-capable model the key can see.
GROQ_MODEL=

# --- Optional: where model downloads go (several GB). The defaults are fine. ---
# HF_HOME=/path/to/cache/huggingface
# TORCH_HOME=/path/to/cache/torch
# UV_CACHE_DIR=/path/to/cache/uv
